def diagnose(history):
    tr_acc, va_acc = history["train_acc"][-1], history["val_acc"][-1]
    gap = tr_acc - va_acc
    print(f"train {tr_acc:.3f}  val {va_acc:.3f}  gap {gap:.3f}")
    if gap > 0.08:
        print("Overfitting")
    elif tr_acc < 0.7:
        print("Underfitting")
    else:
        print("Looks balanced")


class RegularisedCNN(nn.Module):
    def __init__(self, width=64, dropout=0.3):
        super().__init__()
        self.features = nn.Sequential(
            nn.Conv2d(3, width, 3, padding=1), nn.BatchNorm2d(width), nn.ReLU(), nn.MaxPool2d(2),
            nn.Conv2d(width, width * 2, 3, padding=1), nn.BatchNorm2d(width * 2), nn.ReLU(), nn.MaxPool2d(2),
            nn.Conv2d(width * 2, width * 2, 3, padding=1), nn.BatchNorm2d(width * 2), nn.ReLU(), nn.MaxPool2d(2),
            nn.Dropout(dropout),
        )
        self.classifier = nn.Sequential(
            nn.Flatten(),
            nn.Linear(width * 2 * 4 * 4, 128), nn.ReLU(), nn.Dropout(dropout + 0.2),
            nn.Linear(128, 10),
        )

    def forward(self, x):
        return self.classifier(self.features(x))


